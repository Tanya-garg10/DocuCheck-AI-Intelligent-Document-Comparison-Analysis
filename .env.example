# BHARATCODE_API_KEY: Required for BharatCode AI analysis (model: qwen-3.8-27b).
# Obtain from https://bharatcode.ai
BHARATCODE_API_KEY="your_bharatcode_api_key_here"

# GEMINI_API_KEY: Optional fallback / alternative Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"
